NODE_ENV=development
PORT=3000
POSTGRES_PASSWORD=local-only-change-before-deploy
DATABASE_URL=postgres://verus:local-only-change-before-deploy@localhost:5432/verus
SESSION_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.co.za
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
BOOTSTRAP_ADMIN_NAME=Verus Admin
# Set to 1 only when TLS is terminated by your trusted production proxy.
TRUST_PROXY=0
# Set when the database provider requires TLS. "require" is a common hosted-DB setting.
PGSSL=
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
